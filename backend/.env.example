# Airtel OpenAPI base URL — staging first, then production.
#   Staging:    https://openapiuat.airtel.co.tz
#   Production: https://openapi.airtel.co.tz
AIRTEL_BASE_URL=https://openapiuat.airtel.co.tz

# From your Airtel developer app.
AIRTEL_CLIENT_ID=your_client_id
AIRTEL_CLIENT_SECRET=your_client_secret

# Sent as the x-country / x-currency headers.
AIRTEL_COUNTRY=TZ
AIRTEL_CURRENCY=TZS

# Shared secret for the app↔backend call. Generate a long random string; the
# app sends it as `Authorization: Bearer <this>`. Leave empty to disable.
PROXY_API_KEY=change_me_to_a_long_random_string

# Port the server listens on.
PORT=8080
