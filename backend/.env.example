# Copy to .env and fill in. Never commit .env.

# Postgres password (used by both the db and the api services).
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Google OAuth Web client ID (Google Cloud Console → Credentials → OAuth
# client → Web application). The SAME id must be set in the Flutter web build.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# Secret used to sign session tokens. Generate once, keep stable, keep secret:
#   openssl rand -hex 32
SESSION_SECRET=generate-a-64-char-random-hex-string

# Allowed frontend origin(s) for CORS. One, or a comma-separated list, no
# trailing slash. Add http://localhost:8081 while testing the web build locally.
CORS_ORIGIN=https://spenda.flow-hq.com,http://localhost:8081

# Localhost port the API binds to on the VPS; the existing reverse proxy routes
# api.spenda.flow-hq.com → 127.0.0.1:HOST_PORT. Pick one free on the box.
HOST_PORT=8090

# --- Optional: request hardening (sensible defaults shown; all optional) ---
# Largest request body accepted, in bytes (sync pushes everything on first run).
MAX_BODY_BYTES=5000000
# Rate limit: at most RATE_LIMIT_MAX requests per client per window.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_SECONDS=60
# How long a deleted record's tombstone is kept before it's pruned. Must exceed
# the longest a device stays offline, or an old device could resurrect it.
TOMBSTONE_TTL_DAYS=90

# --- Optional: Airtel Money proxy (leave blank to disable that endpoint) ---
AIRTEL_BASE_URL=https://openapi.airtel.co.tz
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_COUNTRY=TZ
AIRTEL_CURRENCY=TZS
PROXY_API_KEY=

# --- Optional: Focus (the desktop app) opening Budget as a private Space ----
# The secret Focus's server signs its link tokens with — the same value as
# BUDGET_LINK_SECRET there (openssl rand -hex 32). Leave blank to keep
# POST /auth/focus off.
FOCUS_LINK_SECRET=
# Only if your Focus account's email differs from the Google account you use
# here: focus-email=google-email (comma-separated pairs).
FOCUS_EMAIL_ALIASES=
